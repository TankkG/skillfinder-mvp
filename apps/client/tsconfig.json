{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "moduleSuffixes": [
      ".web",
      ".native",
      ""
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@skillfinder/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
