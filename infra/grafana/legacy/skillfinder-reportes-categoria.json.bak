  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Todos",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "fg44r1a0qaqrkd"
        },
        "definition": "label_values(skillfinder_service_category_info, category)",
        "description": "Categoria del catalogo automotriz: MEC, CHA, GOM o ELA.",
        "hide": 0,
        "includeAll": true,
        "label": "Categoria",
        "multi": false,
        "name": "categoria",
        "options": [],
        "query": {
          "query": "label_values(skillfinder_service_category_info, category)",
          "refId": "StandardVariableQuery"
        },
