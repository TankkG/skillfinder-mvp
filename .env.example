# ---------------------------------------------------------------------------
# SkillFinder - variables de entorno de ejemplo.
# Copiar como .env en la raiz del repositorio. NUNCA subir el .env real a Git.
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000/api

# MongoDB (local o Atlas). En Atlas usar una cadena mongodb+srv.
MONGODB_URI=mongodb://127.0.0.1:27017/skillfinder

# Secretos JWT (generar valores aleatorios largos en produccion)
JWT_ACCESS_SECRET=cambiar-este-secreto-de-acceso
JWT_REFRESH_SECRET=cambiar-este-secreto-de-renovacion
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Origenes web permitidos, separados por coma
WEB_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173

# Administrador inicial (usado por el script de seed)
ADMIN_NAME=Administrador SkillFinder
ADMIN_EMAIL=admin@skillfinder.bo
ADMIN_PASSWORD=Admin12345!

# Publica automaticamente los perfiles profesionales nuevos.
# Mantener false en produccion para conservar la revision administrativa.
AUTO_APPROVE_PROFESSIONALS=false

# Mapas (la seleccion definitiva debe registrarse en docs/decisions)
MAP_PROVIDER=openstreetmap
MAP_API_KEY=

# Almacenamiento de archivos: local | s3 (local en el MVP)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BUCKET=
UPLOAD_DIR=uploads

# Correo / push (opcionales en el MVP; en desarrollo se registran en consola)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@skillfinder.bo
PUSH_PROVIDER=console
PUSH_CREDENTIALS=

# Reglas de agenda
DEFAULT_TIMEZONE=America/La_Paz
PILOT_SERVICE_AREA_CODE=CBBA-D2
PILOT_SERVICE_AREA_ID=
PILOT_ENFORCE_BOUNDARY=true
BOOKING_SLOT_MINUTES=15
BOOKING_HOLD_MINUTES=15
BOOKING_MIN_ADVANCE_MINUTES=60
BOOKING_MAX_FUTURE_DAYS=60
SERVICE_BUFFER_MINUTES=0

# Limpieza de solicitudes expiradas (ms)
EXPIRATION_JOB_INTERVAL_MS=60000

# Puertos del stack. API_BIND_ADDRESS queda en localhost por defecto; para un
# telefono fisico en la LAN se puede cambiar a 0.0.0.0 y limitarlo con firewall.
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3000
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9090
MONGODB_HOST_PORT=27017

# Cuenta administradora local de Grafana: cambia la contrasena antes de compartir el proyecto
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Cambia-Esta-Clave-Grafana-2026!
GRAFANA_RENDERER_TOKEN=Cambia-Este-Token-Renderer-2026-Largo

# Intervalo del colector de metricas (ms) y umbral minimo de registros por distrito
GRAFANA_METRICS_REFRESH_MS=30000
GRAFANA_MIN_DISTRICT_RECORDS=5

# Solo localhost en ejecucion local; Docker Compose lo sobrescribe a 0.0.0.0 en su red privada.
METRICS_PORT=9100
METRICS_BIND_ADDRESS=127.0.0.1
