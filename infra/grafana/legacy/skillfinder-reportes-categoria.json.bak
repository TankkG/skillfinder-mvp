  "description": "Reportes internos por categoria automotriz: demanda de servicios, ranking de profesionales, distribucion de calificaciones y ranking seudonimizado de clientes.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fg44r1a0qaqrkd"
      },
      "description": "Servicios completados agrupados por subservicio. Cambia la categoria en el selector superior.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fg44r1a0qaqrkd"
          },
          "editorMode": "code",
          "expr": "topk(10, skillfinder_services_completed_by_category{category=~\"$categoria\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{subservice}}"
        }
      ],
      "title": "Servicios mas utilizados en la categoria",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fg44r1a0qaqrkd"
      },
      "description": "Ranking interno: requiere al menos tres resenas publicadas. El nombre comercial se muestra solo dentro del proyecto.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.business_name}"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fg44r1a0qaqrkd"
          },
          "editorMode": "code",
          "expr": "skillfinder_professional_ranking{category=~\"$categoria\", position=\"1\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "Mejor profesional de la categoria (promedio)",
      "type": "stat"
    },
