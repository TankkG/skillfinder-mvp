NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000/api

MONGODB_URI=mongodb://127.0.0.1:27017/skillfinder

JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresco
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

WEB_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

ADMIN_NAME=Administrador SkillFinder
ADMIN_EMAIL=admin@skillfinder.bo
ADMIN_PASSWORD=Admin12345!

MAP_PROVIDER=openstreetmap
MAP_API_KEY=
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BUCKET=
UPLOAD_DIR=uploads

EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@skillfinder.bo
PUSH_PROVIDER=console
PUSH_CREDENTIALS=

DEFAULT_TIMEZONE=America/La_Paz
PILOT_SERVICE_AREA_CODE=CBBA-D2
PILOT_SERVICE_AREA_ID=
PILOT_ENFORCE_BOUNDARY=true

BOOKING_SLOT_MINUTES=15
BOOKING_HOLD_MINUTES=15
BOOKING_MIN_ADVANCE_MINUTES=60
BOOKING_MAX_FUTURE_DAYS=60
SERVICE_BUFFER_MINUTES=0
EXPIRATION_JOB_INTERVAL_MS=60000

# Exportador Prometheus interno (no publicar este puerto en redes externas)
METRICS_PORT=9100
METRICS_BIND_ADDRESS=127.0.0.1
GRAFANA_METRICS_REFRESH_MS=30000
GRAFANA_MIN_DISTRICT_RECORDS=5
